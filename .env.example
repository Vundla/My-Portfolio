# Enterprise Authentication Configuration
# Use this for your Codex Sanctium portfolio

# GitHub OAuth App Configuration
CLIENT_ID=your_github_oauth_app_client_id
CLIENT_SECRET=your_github_oauth_app_client_secret

# GitHub URLs (use these - no custom domain needed!)
GITHUB_BASE_URL=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_PROFILE_URL=https://github.com/Vundla
GITHUB_PORTFOLIO_URL=https://github.com/Vundla/My-Portfolio

# Authentication endpoints
AUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
AUTH_TOKEN_URL=https://github.com/login/oauth/access_token
AUTH_USER_URL=https://api.github.com/user

# Your portfolio URLs (use GitHub Pages or Fly.io)
FRONTEND_URL=https://vundla.github.io/My-Portfolio
BACKEND_URL=https://codex-sanctium-api.fly.dev
PORTFOLIO_DEMO_URL=https://vundla.github.io

# Enterprise features
GITHUB_ENTERPRISE_ORG=your_organization_name
GITHUB_ENTERPRISE_TEAM=developers
CODESPACES_ENABLED=true
ACTIONS_ENABLED=true
PACKAGES_ENABLED=true